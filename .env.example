# SOC Monitor Advanced - Variables de Entorno
# Copia este archivo como .env y edita con tus valores reales

# Aplicación
APP_NAME=SOC Monitor Advanced
APP_VERSION=2.0.0
DEBUG=false
PORT=8000

# Seguridad
SECRET_KEY=change-this-to-a-random-32-byte-key-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://soc_user:***@localhost:5432/soc_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Slack
SLACK_BOT_TOKEN=xoxb-y-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-1-your-app-token-here (optional)
SLACK_CHANNEL_ID=C1234567890 (optional)

# Redis
REDIS_URL=redis://localhost:6379/0

